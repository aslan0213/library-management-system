{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Services.BackgroundJobs": "Information",
      "Services.Notifications": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=PROD_HOST;Database=library_management;Username=PROD_USER;Password=PROD_PASSWORD",
    "Redis": "PROD_REDIS_HOST:6379,password=PROD_REDIS_PASSWORD"
  },
  "FileStorage": {
    "BasePath": "/var/lib/library-management/storage",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png" ]
  }
}